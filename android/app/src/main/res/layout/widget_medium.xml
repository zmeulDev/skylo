<?xml version="1.0" encoding="utf-8"?>
<!-- Skylo widget, medium cell: small layout + 4-slot hourly row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/widget_surface"
    android:padding="12dp">

    <TextView
        android:id="@+id/wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:text="@string/widget_wordmark"
        android:fontFamily="@font/inter_semibold"
        android:textSize="10sp"
        android:letterSpacing="0.3"
        android:textColor="@color/widget_ink" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_extra_light"
            android:textSize="52sp"
            android:includeFontPadding="false"
            android:textColor="@color/widget_ink"
            tools:text="21" />

        <TextView
            android:id="@+id/temp_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFamily="@font/inter_regular"
            android:textSize="16sp"
            android:textColor="@color/widget_accent"
            tools:text="°C" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            tools:text="Cluj-Napoca" />

        <ImageView
            android:id="@+id/condition_glyph"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_condition"
            tools:src="@drawable/widget_glyph_sun" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:background="@color/widget_hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <!-- Four equal hourly slots; empty slots stay blank. -->
        <LinearLayout style="@style/WidgetHourSlot">
            <TextView android:id="@+id/h0_time" style="@style/WidgetHourTime" tools:text="15" />
            <ImageView android:id="@+id/h0_glyph" style="@style/WidgetHourGlyph"
                android:contentDescription="@string/widget_condition" tools:src="@drawable/widget_glyph_sun" />
            <TextView android:id="@+id/h0_temp" style="@style/WidgetHourTemp" tools:text="22°" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetHourSlot">
            <TextView android:id="@+id/h1_time" style="@style/WidgetHourTime" tools:text="18" />
            <ImageView android:id="@+id/h1_glyph" style="@style/WidgetHourGlyph"
                android:contentDescription="@string/widget_condition" tools:src="@drawable/widget_glyph_sun" />
            <TextView android:id="@+id/h1_temp" style="@style/WidgetHourTemp" tools:text="21°" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetHourSlot">
            <TextView android:id="@+id/h2_time" style="@style/WidgetHourTime" tools:text="21" />
            <ImageView android:id="@+id/h2_glyph" style="@style/WidgetHourGlyph"
                android:contentDescription="@string/widget_condition" tools:src="@drawable/widget_glyph_sun" />
            <TextView android:id="@+id/h2_temp" style="@style/WidgetHourTemp" tools:text="19°" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetHourSlot">
            <TextView android:id="@+id/h3_time" style="@style/WidgetHourTime" tools:text="00" />
            <ImageView android:id="@+id/h3_glyph" style="@style/WidgetHourGlyph"
                android:contentDescription="@string/widget_condition" tools:src="@drawable/widget_glyph_sun" />
            <TextView android:id="@+id/h3_temp" style="@style/WidgetHourTemp" tools:text="17°" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>