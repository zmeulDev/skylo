<?xml version="1.0" encoding="utf-8"?>
<!-- Shown before the app has ever published a snapshot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/widget_surface"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:text="@string/widget_wordmark"
        android:fontFamily="@font/inter_semibold"
        android:textSize="10sp"
        android:letterSpacing="0.3"
        android:textColor="@color/widget_ink" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_empty_title"
        android:fontFamily="@font/inter_semibold"
        android:textSize="16sp"
        android:textColor="@color/widget_ink" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_empty_message"
        android:fontFamily="@font/inter_regular"
        android:textSize="12sp"
        android:textColor="@color/widget_muted" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>